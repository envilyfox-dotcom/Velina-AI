# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Comma-separated Discord channel IDs where the bot responds.
TARGET_CHANNEL_IDS=

# Optional comma-separated Discord user IDs allowed to use owner-only commands.
OWNER_IDS=

# Optional comma-separated channel IDs where the bot stays silent.
# Owner-only announcements can still bypass this list.
DISABLED_CHANNELS=

# Ollama model name.
OLLAMA_MODEL=

# Optional voice settings.
WHISPER_MODEL_SIZE=base
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
